{
  "name": "afk-minecraft-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Minecraft AFK/PvP/survival bot with terrain-aware movement, an autonomous behaviour engine, a TUI dashboard and an `mc` CLI",
  "type": "commonjs",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "tui": "node src/tui.js",
    "demo": "node src/bot.js --demo",
    "demo:tui": "node src/tui.js --demo",
    "probe": "python3 src/probe.py",
    "poll": "python3 src/poller.py",
    "test": "node tests/run_tests.js",
    "mc": "node bin/mc.js",
    "link": "npm link --no-audit --no-fund"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.20.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-registry": "^1.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mc": "bin/mc.js",
    "mc-bot": "bin/mc.js"
  }
}
