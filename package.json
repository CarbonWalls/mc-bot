{
  "name": "afk-minecraft-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Passive AFK Minecraft bot for an online-mode=false Aternos server",
  "type": "commonjs",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "tui": "node src/tui.js",
    "demo": "node src/bot.js --demo",
    "demo:tui": "node src/tui.js --demo",
    "probe": "python3 src/probe.py",
    "poll": "python3 src/poller.py",
    "test": "node tests/run_tests.js"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.20.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-registry": "^1.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
